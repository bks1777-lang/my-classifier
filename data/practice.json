[
 {
  "id": "P01",
  "text": "오늘 들어온 두부에서 쉰내가 나요. 조리 전에 확인 부탁드립니다.",
  "category": "품질·안전",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "P02",
  "text": "시금치에 흙이 너무 많고 잎이 누렇게 떴어요.",
  "category": "품질·안전",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P03",
  "text": "닭고기 포장이 뜯어진 채로 왔습니다. 냉장 온도도 높았어요.",
  "category": "품질·안전",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "P04",
  "text": "사과 상자 안에 멍든 게 절반이에요.",
  "category": "품질·안전",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P05",
  "text": "양배추 속에서 벌레가 나왔어요. 오늘 점심에 써야 하는데요.",
  "category": "품질·안전",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "P06",
  "text": "국내산이라고 했는데 포장에 중국산 스티커가 붙어 있어요.",
  "category": "품질·안전",
  "urgency": "높음",
  "note": "원산지가 다름 — 서류가 아니라 물건의 문제"
 },
 {
  "id": "P07",
  "text": "계란 몇 판이 깨져서 왔어요.",
  "category": "품질·안전",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P08",
  "text": "어묵 유통기한이 내일까지인데 이렇게 짧게 와도 되나요?",
  "category": "품질·안전",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P09",
  "text": "냉동 새우가 다 녹은 상태로 도착했습니다. 영양사 김하늘입니다.",
  "category": "품질·안전",
  "urgency": "높음",
  "note": "가짜 이름 — 가림 시험용"
 },
 {
  "id": "P10",
  "text": "지난번 감자는 싹이 많이 나 있었어요. 다음엔 신경 써 주세요.",
  "category": "품질·안전",
  "urgency": "낮음",
  "note": "지난 일 — 오늘 급식은 괜찮다"
 },
 {
  "id": "P11",
  "text": "8시까지 와야 하는데 아직 안 왔어요. 연락 주세요 010-2345-6789",
  "category": "배송",
  "urgency": "높음",
  "note": "가짜 번호 — 가림 시험용"
 },
 {
  "id": "P12",
  "text": "우유가 빠졌어요. 명세서에는 있는데 물건이 없어요.",
  "category": "배송",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "P13",
  "text": "다음 주부터 배송을 7시 반으로 당겨 줄 수 있나요?",
  "category": "배송",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P14",
  "text": "기사님이 후문 말고 정문으로 들어오셔서 검수가 늦어졌어요.",
  "category": "배송",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P15",
  "text": "어제 배송 차가 30분 늦게 왔어요.",
  "category": "배송",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P16",
  "text": "방학 중 돌봄교실 배송은 어떻게 되나요?",
  "category": "배송",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P17",
  "text": "대파가 두 박스 와야 하는데 한 박스만 왔어요.",
  "category": "배송",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P18",
  "text": "오늘 배송 차량 도착 예정 시간 알려 주세요.",
  "category": "배송",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P19",
  "text": "다른 학교 물건이 저희 학교로 잘못 왔어요.",
  "category": "배송",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P20",
  "text": "배송이 매번 늦어서 조리 시간이 빠듯해요.",
  "category": "배송",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P21",
  "text": "내일 감자 10kg만 더 넣어 주세요.",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P22",
  "text": "다음 주 수요일 발주한 오이 취소할게요. 현장학습이라서요.",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P23",
  "text": "애호박이 없으면 대체품으로 뭐가 되나요?",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P24",
  "text": "발주 마감이 몇 시까지예요?",
  "category": "발주·변경",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P25",
  "text": "금요일 메뉴가 바뀌어서 돼지고기를 닭고기로 바꾸고 싶어요.",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P26",
  "text": "내일 급식 인원이 50명 줄었어요. 수량 조정 부탁드려요.",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P27",
  "text": "발주서를 잘못 올렸어요. 양파 100kg이 아니라 10kg입니다.",
  "category": "발주·변경",
  "urgency": "높음",
  "note": "내일 그대로 오면 바로 탈이 난다"
 },
 {
  "id": "P28",
  "text": "다음 달 발주 품목표는 언제 나오나요?",
  "category": "발주·변경",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P29",
  "text": "쌀 발주량 늘리고 싶은데 어떻게 하면 되나요?",
  "category": "발주·변경",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P30",
  "text": "학교 행사로 다음 주 월요일 급식이 없어요. 발주 전부 빼 주세요.",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P31",
  "text": "이번 달 정산서 양파 단가가 계약 단가랑 달라요.",
  "category": "단가·정산",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P32",
  "text": "청구 금액이 지난달보다 너무 많이 나왔어요.",
  "category": "단가·정산",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P33",
  "text": "반품한 배추 금액이 정산에서 안 빠졌어요.",
  "category": "단가·정산",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P34",
  "text": "계산서 발행은 언제 되나요?",
  "category": "단가·정산",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P35",
  "text": "단가표 새로 나온 거 보내 주세요.",
  "category": "단가·정산",
  "urgency": "낮음",
  "note": "단가표는 종이지만 대상은 돈"
 },
 {
  "id": "P36",
  "text": "같은 품목이 두 번 청구됐어요. 확인 부탁드립니다.",
  "category": "단가·정산",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P37",
  "text": "행정실에서 이번 주까지 정산 마감이래요. 정산서 빨리 주세요.",
  "category": "단가·정산",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "P38",
  "text": "친환경 쌀 차액 지원금은 어떻게 계산되나요?",
  "category": "단가·정산",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P39",
  "text": "단가가 갑자기 올랐는데 이유가 뭔가요?",
  "category": "단가·정산",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P40",
  "text": "입금했는데 미납으로 나와요. 행정실 박민준 주무관입니다.",
  "category": "단가·정산",
  "urgency": "보통",
  "note": "가짜 이름 — 가림 시험용"
 },
 {
  "id": "P41",
  "text": "친환경 인증서 사본 보내 주실 수 있나요?",
  "category": "서류·인증",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P42",
  "text": "감사 때문에 원산지 증명서가 필요해요. 내일까지요.",
  "category": "서류·인증",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "P43",
  "text": "검수 확인서 양식이 바뀌었나요?",
  "category": "서류·인증",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P44",
  "text": "농산물 잔류농약 검사 성적서 받을 수 있나요?",
  "category": "서류·인증",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P45",
  "text": "GAP 인증 농가 명단 좀 보내 주세요.",
  "category": "서류·인증",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P46",
  "text": "납품업체 등록 서류 갱신은 언제 해야 하나요?",
  "category": "서류·인증",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P47",
  "text": "거래명세서에 원산지 표기가 빠져 있어요.",
  "category": "서류·인증",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P48",
  "text": "학부모 모니터링단이 인증 서류를 보고 싶어 해요.",
  "category": "서류·인증",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P49",
  "text": "HACCP 인증서 유효기간이 지난 것 같아요. 새 걸로 주세요.",
  "category": "서류·인증",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "P50",
  "text": "교육청 점검 나온대요. 납품 관련 서류 묶음으로 보내 주세요.",
  "category": "서류·인증",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "P51",
  "text": "늘 신선한 재료 보내 주셔서 감사합니다.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P52",
  "text": "새로 온 영양사입니다. 담당자 연락처 알려 주세요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P53",
  "text": "센터 견학 프로그램이 있나요? 학생들이 가 보고 싶어 해요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P54",
  "text": "지역 농산물 홍보 자료가 있으면 받고 싶어요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P55",
  "text": "담당자분 바뀌셨나요?",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P56",
  "text": "내년 계약 일정은 어떻게 되나요?",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P57",
  "text": "식재료 꾸러미 체험 행사 신청은 어디서 해요?",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P58",
  "text": "농가 소개 영상 있으면 급식 시간에 틀고 싶어요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P59",
  "text": "연말에 감사 인사 드리러 가도 될까요?",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "P60",
  "text": "식중독 예방 교육 자료 있나요?",
  "category": "기타",
  "urgency": "낮음",
  "note": "안전을 묻지만 사고가 아니다 — 자료 문의"
 }
]