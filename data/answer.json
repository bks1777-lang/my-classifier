[
 {
  "id": "A01",
  "text": "우엉에서 곰팡이 핀 게 섞여 왔어요.",
  "category": "품질·안전",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "A02",
  "text": "납품된 돼지고기 색이 이상하고 냄새가 좀 나요. 써도 될까요?",
  "category": "품질·안전",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A03",
  "text": "계란에 금 간 게 많고 닭털이 붙어 있어요.",
  "category": "품질·안전",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A04",
  "text": "아이들이 먹고 배 아프다는 얘기가 있어서요. 어제 들어온 콩나물 확인 좀 해 주세요.",
  "category": "품질·안전",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "A05",
  "text": "친환경이라고 했는데 농약 냄새가 나는 것 같아요.",
  "category": "품질·안전",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A06",
  "text": "과일이 너무 덜 익어서 아이들이 못 먹어요. 다음 배송분은 바꿔 주세요.",
  "category": "품질·안전",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A07",
  "text": "차가 아직 출발도 안 했다고요? 점심 준비해야 하는데요.",
  "category": "배송",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A08",
  "text": "배추가 상해서 왔고 그나마 한 박스는 오지도 않았어요.",
  "category": "품질·안전",
  "urgency": "보통",
  "note": "품질·안전 ↔ 배송 — 둘 다로 봤다. 순서상 품질·안전"
 },
 {
  "id": "A09",
  "text": "다음 학기에는 배송 요일을 화목으로 바꿀 수 있을까요?",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A10",
  "text": "기사님 성함과 연락처 좀 알려 주세요. 010-9876-5432로 연락 부탁해요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A11",
  "text": "목요일 물량이 금요일에 같이 왔어요.",
  "category": "배송",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A12",
  "text": "체험학습이라 내일 급식 없습니다. 들어올 물건 다 멈춰 주세요.",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A13",
  "text": "깍두기용 무를 5kg에서 8kg으로 늘려 주세요.",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A14",
  "text": "표고버섯 대신 새송이로 받을 수 있을까요?",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A15",
  "text": "발주 시스템에 로그인이 안 돼요. 마감이 한 시간 남았어요.",
  "category": "발주·변경",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A16",
  "text": "수량을 잘못 적었는데 이미 마감됐어요. 지금이라도 될까요?",
  "category": "기타",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A17",
  "text": "지난달 거래명세서 합계가 정산서랑 안 맞아요.",
  "category": "단가·정산",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A18",
  "text": "이번 분기 지원금 정산은 어떻게 하나요?",
  "category": "단가·정산",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A19",
  "text": "반품 처리한 사과값이 아직 청구돼 있어요. 맞나요?",
  "category": "단가·정산",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A20",
  "text": "시장 가격보다 너무 비싼 것 같아요. 단가 산정 기준이 궁금해요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A21",
  "text": "원산지 증빙 자료를 오늘 안에 교육청에 내야 해요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A22",
  "text": "유기농 인증 번호를 명세서에 같이 적어 주실 수 있나요?",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A23",
  "text": "농가별 생산 이력 자료가 필요해요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A24",
  "text": "검사 성적서 날짜가 작년 거예요.",
  "category": "기타",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A25",
  "text": "항상 친절하게 응대해 주셔서 감사해요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A26",
  "text": "영양교사 연수 때 센터 소개 좀 해 주실 수 있나요?",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A27",
  "text": "이물질이 나오면 어디로 신고해야 하나요? 절차가 궁금해요.",
  "category": "품질·안전",
  "urgency": "높음",
  "note": ""
 },
 {
  "id": "A28",
  "text": "식재료 보관 온도 기준 안내문 있으면 받고 싶어요.",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 },
 {
  "id": "A29",
  "text": "오늘 들어온 생선이 냄새가 너무 심해서 반품하고 정산에서 빼 주세요.",
  "category": "단가·정산",
  "urgency": "보통",
  "note": ""
 },
 {
  "id": "A30",
  "text": "내년부터 납품 학교가 늘어난다던데 저희도 포함인가요?",
  "category": "기타",
  "urgency": "낮음",
  "note": ""
 }
]